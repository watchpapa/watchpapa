# Copy to .dev.vars (gitignored) for `wrangler dev`.
# TMDB v3 API key (same value as the droplet's TMDB_API_KEY_SECRET).
TMDB_API_KEY_SECRET=

# For local DB access, ALSO export this in your shell before `wrangler dev`
# (it is not read from .dev.vars — it is a wrangler-recognised env var):
#   export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://USER:PASS@HOST:5432/postgres?sslmode=require"
# Use the Supabase session pooler URL (the same DATABASE_URL the droplet uses).
