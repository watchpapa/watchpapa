{
  "name": "watchpapa-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "lint": "eslint src test",
    "dup": "jscpd",
    "prepare": "cd .. && husky worker/.husky || true"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.3.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.36.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20241230.0": true,
    "workerd@1.20260831.1": true
  },
  "lint-staged": {
    "*.js": [
      "eslint --no-warn-ignored",
      "prettier --check --ignore-unknown",
      "vitest related --run --passWithNoTests"
    ]
  }
}
