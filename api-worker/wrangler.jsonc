{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "watchpapa-api",
  "main": "src/index.js",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api.watchpapa.tv/*",
      "zone_name": "watchpapa.tv"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://watchpapa.tv"
  }
}
