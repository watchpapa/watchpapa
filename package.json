{
  "name": "watchpapa",
  "version": "2.0.0",
  "description": "watchpapa — root holds DB migrations + RLS tests. App = Frontend/ (Cloudflare Pages) + worker/ (Cloudflare Worker API).",
  "type": "module",
  "private": true,
  "scripts": {
    "test:rls": "node --test \"tests/rls_tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:backup": "node --test --test-concurrency=1 \"tests/backup/**/*.test.js\"",
    "test:smoke": "node --test \"tests/smoke/**/*.test.js\"",
    "test:py": "pytest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  }
}
